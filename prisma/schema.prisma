// Kaiken AI — Prisma schema (single source of truth).
// Prisma ORM v7: uses the `prisma-client` generator (generated client lives
// in `generated/prisma`) and relies on `prisma.config.ts` for the datasource
// URL. A driver adapter (`@prisma/adapter-pg`) is required at runtime.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  PRO
}

enum ParseStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum FileType {
  PDF
  DOCX
  TXT
  MD
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum KeywordCategory {
  PRESENT
  MISSING
}

enum KeywordImportance {
  HIGH
  MEDIUM
  LOW
}

enum SuggestionType {
  CONTENT
  KEYWORD
  FORMAT
  ACTION
}

enum Severity {
  HIGH
  MEDIUM
  LOW
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ResumeFormat {
  MARKDOWN
  PDF
}

enum CreditType {
  EARN
  SPEND
  ADJUST
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String    @unique
  name          String?
  imageUrl      String?
  plan          Plan      @default(FREE)
  credits       Int       @default(0)
  emailVerified DateTime?

  resumes           Resume[]
  jobDescriptions   JobDescription[]
  analyses          Analysis[]
  generatedResumes  GeneratedResume[]
  creditTransactions CreditTransaction[]
  subscription      Subscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plan])
  @@index([createdAt])
}

model Subscription {
  id                    String             @id @default(cuid())
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan                  Plan
  status                SubscriptionStatus @default(ACTIVE)
  stripeCustomerId      String?            @unique
  stripeSubscriptionId  String?            @unique
  currentPeriodEnd      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model CreditTransaction {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      CreditType
  amount    Int
  reason    String?
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

model Resume {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  role          String?

  fileName      String
  fileKey       String      @unique
  fileUrl       String
  fileType      FileType
  fileSize      Int

  parseStatus   ParseStatus @default(PENDING)
  extractedText String?
  parseError    String?

  analyses         Analysis[]
  generatedResumes GeneratedResume[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
}

model JobDescription {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  company String?
  content String

  analyses         Analysis[]
  generatedResumes GeneratedResume[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
}

model Analysis {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId         String
  resume           Resume          @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobDescriptionId String?
  jobDescription   JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)

  // Immutable snapshot of the exact inputs used for this evaluation so that
  // historical reports stay stable even if the source resume/JD is later
  // re-parsed or edited.
  inputSnapshot Json?

  status          AnalysisStatus  @default(PENDING)
  error           String?

  atsScore        Int?
  formatScore     Int?
  keywordScore    Int?
  contentScore    Int?
  summary         String?
  strengths       Json?
  improvements    Json?
  modelVersion    String?
  analyzedAt      DateTime?

  keywords    KeywordMatch[]
  suggestions Suggestion[]
  generatedResumes GeneratedResume[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
  @@index([resumeId])
  @@index([jobDescriptionId])
}

model KeywordMatch {
  id          String            @id @default(cuid())
  analysisId  String
  analysis    Analysis          @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  keyword     String
  category    KeywordCategory
  importance  KeywordImportance @default(MEDIUM)
  count       Int               @default(0)

  @@index([analysisId])
  @@index([analysisId, category])
}

model Suggestion {
  id          String         @id @default(cuid())
  analysisId  String
  analysis    Analysis       @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  type        SuggestionType
  section     String?
  severity    Severity       @default(MEDIUM)
  title       String
  description String
  aiRewrite   String?

  @@index([analysisId])
  @@index([analysisId, type])
}

model GeneratedResume {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceResumeId   String
  sourceResume     Resume           @relation(fields: [sourceResumeId], references: [id], onDelete: Cascade)
  analysisId       String?
  analysis         Analysis?        @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  jobDescriptionId String?
  jobDescription   JobDescription?  @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)

  content     Json
  format      ResumeFormat     @default(MARKDOWN)
  status      GenerationStatus @default(PENDING)
  error       String?
  downloadUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
  @@index([sourceResumeId])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  source      String
  eventType   String
  eventId     String    @unique
  payload     Json
  processed   Boolean   @default(false)
  error       String?
  processedAt DateTime?

  createdAt DateTime @default(now())

  @@index([source, processed])
  @@index([createdAt])
}
