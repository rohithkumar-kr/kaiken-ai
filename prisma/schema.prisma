generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid())
  clerkId            String              @unique
  email              String              @unique
  name               String?
  imageUrl           String?
  plan               Plan                @default(FREE)
  credits            Int                 @default(0)
  emailVerified      DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lastLoginAt        DateTime?
  analyses           Analysis[]
  coverLetters       CoverLetter[]
  creditTransactions CreditTransaction[]
  generatedResumes   GeneratedResume[]
  interviewAnswers   InterviewAnswer[]
  interviewSessions  InterviewSession[]
  jobDescriptions    JobDescription[]
  resumes            Resume[]
  subscription       Subscription?

  @@index([plan])
  @@index([createdAt])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 Plan
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model CreditTransaction {
  id        String     @id @default(cuid())
  userId    String
  type      CreditType
  amount    Int
  reason    String?
  metadata  Json?
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model Resume {
  id               String            @id @default(cuid())
  userId           String
  title            String
  fileName         String
  fileKey          String            @unique
  fileUrl          String
  fileType         FileType
  fileSize         Int
  parseStatus      ParseStatus       @default(PENDING)
  parseError       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  checksum         String?
  isPrimary        Boolean           @default(false)
  rawText          String?
  targetRole       String?
  analyses         Analysis[]
  generatedResumes GeneratedResume[]
  parsedResume     ParsedResume?
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model JobDescription {
  id               String            @id @default(cuid())
  userId           String
  title            String
  company          String?
  content          String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  analyses         Analysis[]
  generatedResumes GeneratedResume[]
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model Analysis {
  id               String            @id @default(cuid())
  userId           String
  resumeId         String
  jobDescriptionId String?
  inputSnapshot    Json?
  status           AnalysisStatus    @default(PENDING)
  error            String?
  atsScore         Int?
  formatScore      Int?
  keywordScore     Int?
  contentScore     Int?
  summary          String?
  strengths        Json?
  improvements     Json?
  modelVersion     String?
  analyzedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  grammarScore     Int?
  processingTime   Int?
  weaknesses       Json?
  jobDescription   JobDescription?   @relation(fields: [jobDescriptionId], references: [id])
  resume           Resume            @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedResumes GeneratedResume[]
  keywords         KeywordMatch[]
  suggestions      Suggestion[]
  coverLetters     CoverLetter[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([resumeId])
  @@index([jobDescriptionId])
}

model KeywordMatch {
  id         String            @id @default(cuid())
  analysisId String
  keyword    String
  category   KeywordCategory
  importance KeywordImportance @default(MEDIUM)
  count      Int               @default(0)
  section    String?
  analysis   Analysis          @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([analysisId, category])
}

model Suggestion {
  id          String         @id @default(cuid())
  analysisId  String
  type        SuggestionType
  section     String?
  severity    Severity       @default(MEDIUM)
  title       String
  description String
  aiRewrite   String?
  accepted    Boolean        @default(false)
  analysis    Analysis       @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([analysisId, type])
}

model GeneratedResume {
  id               String           @id @default(cuid())
  userId           String
  sourceResumeId   String
  analysisId       String?
  jobDescriptionId String?
  format           ResumeFormat     @default(MARKDOWN)
  status           GenerationStatus @default(PENDING)
  error            String?
  downloadUrl      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  markdown         String
  data             Json?
  analysis         Analysis?        @relation(fields: [analysisId], references: [id])
  coverLetters     CoverLetter[]
  jobDescription   JobDescription?  @relation(fields: [jobDescriptionId], references: [id])
  sourceResume     Resume           @relation(fields: [sourceResumeId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([sourceResumeId])
}

model CoverLetter {
  id                String            @id @default(cuid())
  userId            String
  analysisId        String
  generatedResumeId String?
  content           String
  status            GenerationStatus  @default(COMPLETED)
  error             String?
  modelVersion      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  analysis          Analysis          @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  generatedResume   GeneratedResume?  @relation(fields: [generatedResumeId], references: [id])
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([analysisId])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  source      String
  eventType   String
  eventId     String    @unique
  payload     Json
  processed   Boolean   @default(false)
  error       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([source, processed])
  @@index([createdAt])
}

model ParsedResume {
  id             String          @id @default(cuid())
  resumeId       String          @unique
  name           String?
  email          String?
  phone          String?
  summary        String?
  modelVersion   String?
  parsedAt       DateTime        @default(now())
  resume         Resume          @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  skills         Skill[]
  experiences    Experience[]
  projects       Project[]
  educations     Education[]
  certifications Certification[]

  @@index([resumeId])
}

model Skill {
  id             String        @id @default(cuid())
  parsedResumeId String
  name           String
  category       String?
  order          Int           @default(0)
  parsedResume   ParsedResume  @relation(fields: [parsedResumeId], references: [id], onDelete: Cascade)

  @@index([parsedResumeId])
}

model Experience {
  id             String        @id @default(cuid())
  parsedResumeId String
  title          String
  company        String?
  location       String?
  startDate      String?
  endDate        String?
  description    String?
  order          Int           @default(0)
  parsedResume   ParsedResume  @relation(fields: [parsedResumeId], references: [id], onDelete: Cascade)

  @@index([parsedResumeId])
}

model Project {
  id             String        @id @default(cuid())
  parsedResumeId String
  name           String
  description    String?
  technologies   Json?
  url            String?
  startDate      String?
  endDate        String?
  order          Int           @default(0)
  parsedResume   ParsedResume  @relation(fields: [parsedResumeId], references: [id], onDelete: Cascade)

  @@index([parsedResumeId])
}

model Education {
  id             String        @id @default(cuid())
  parsedResumeId String
  institution    String
  degree         String?
  fieldOfStudy   String?
  startDate      String?
  endDate        String?
  grade          String?
  order          Int           @default(0)
  parsedResume   ParsedResume  @relation(fields: [parsedResumeId], references: [id], onDelete: Cascade)

  @@index([parsedResumeId])
}

model Certification {
  id             String        @id @default(cuid())
  parsedResumeId String
  name           String
  issuer         String?
  date           String?
  url            String?
  order          Int           @default(0)
  parsedResume   ParsedResume  @relation(fields: [parsedResumeId], references: [id], onDelete: Cascade)

  @@index([parsedResumeId])
}

enum Plan {
  FREE
  PRO
}

enum ParseStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum FileType {
  PDF
  DOCX
  TXT
  MD
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum KeywordCategory {
  PRESENT
  MISSING
}

enum KeywordImportance {
  HIGH
  MEDIUM
  LOW
}

enum SuggestionType {
  CONTENT
  KEYWORD
  FORMAT
  ACTION
}

enum Severity {
  HIGH
  MEDIUM
  LOW
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ResumeFormat {
  MARKDOWN
  PDF
}

model InterviewSession {
  id                String              @id @default(cuid())
  userId            String
  jobRole           String
  company           String?
  experienceLevel   ExperienceLevel     @default(MID)
  interviewType     InterviewType       @default(MIXED)
  overallScore      Int?
  completedAt       DateTime?
  reportGeneratedAt DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions         InterviewQuestion[]
  answers           InterviewAnswer[]

  @@index([userId])
  @@index([userId, createdAt])
}

model InterviewQuestion {
  id               String            @id @default(cuid())
  sessionId        String
  questionNumber   Int
  question         String
  difficulty       QuestionDifficulty
  category         QuestionCategory
  expectedDuration Int
  createdAt        DateTime          @default(now())
  session          InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answer           InterviewAnswer?

  @@index([sessionId])
  @@index([sessionId, questionNumber])
}

model InterviewAnswer {
  id                    String            @id @default(cuid())
  questionId            String            @unique
  sessionId             String
  userId                String
  answer                String            @default("")
  startedAt             DateTime?
  evaluationScore       Int?
  strengths             Json?
  weaknesses            Json?
  suggestions           Json?
  idealAnswer           String?
  evaluationModelVersion String?
  evaluatedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  question              InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  session               InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
}

enum InterviewType {
  HR
  TECHNICAL
  BEHAVIORAL
  MIXED
}

enum ExperienceLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
}

enum QuestionCategory {
  TECHNICAL
  BEHAVIORAL
  PROJECTS
  RESUME
  PROBLEM_SOLVING
  SYSTEM_DESIGN
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum CreditType {
  EARN
  SPEND
  ADJUST
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}
